mouse.Button1Down:Connect(function()
    if tpOn then
        local _, root = character()
        if root then root.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0,4,0)) end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    local _, root = character()
    if not root then return end

    if flying then
        local bv = root:FindFirstChild("OverlordVelocity")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "OverlordVelocity"
            bv.MaxForce = Vector3.new(1e6,1e6,1e6)
            bv.Parent = root
        end
        local bg = root:FindFirstChild("OverlordGyro")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "OverlordGyro"
            bg.MaxTorque = Vector3.new(1e6,1e6,1e6)
            bg.Parent = root
        end

        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

        bv.Velocity = dir.Magnitude > 0 and dir.Unit*flySpeed or Vector3.zero
        bg.CFrame = cam.CFrame
    else
        local bv = root:FindFirstChild("OverlordVelocity")
        local bg = root:FindFirstChild("OverlordGyro")
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end

    if spinning then
        angle += dt * 25
        root.CFrame = root.CFrame * CFrame.Angles(0, angle, 0)
    end
end)

