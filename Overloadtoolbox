-- Drag window
local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local d = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X,
            startPos.Y.Scale, startPos.Y.Offset+d.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

local function character()
    local c = player.Character
    if not c then return end
    return c, c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

local function button(label, y, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -24, 0, 35)
    b.Position = UDim2.fromOffset(12, y)
    b.BackgroundColor3 = Color3.fromRGB(43, 20, 75)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = label
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.Parent = frame
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(125, 50, 220)
    b.MouseButton1Click:Connect(callback)
    return b
end

local function slider(label, y, min, max, initial, callback)
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -24, 0, 20)
    txt.Position = UDim2.fromOffset(12, y)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.fromRGB(220, 190, 255)
    txt.Font = Enum.Font.Gotham
    txt.TextSize = 12
    txt.Text = label .. ": " .. initial
    txt.Parent = frame

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -24, 0, 12)
    bar.Position = UDim2.fromOffset(12, y+23)
    bar.Text = ""
    bar.BackgroundColor3 = Color3.fromRGB(65, 40, 95)
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((initial-min)/(max-min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(180, 70, 255)
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

    local function setFromX(x)
        local a = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local value = math.floor(min+a*(max-min))
        fill.Size = UDim2.new(a,0,1,0)
        txt.Text = label .. ": " .. value
        callback(value)
    end
    bar.MouseButton1Down:Connect(function()
        setFromX(mouse.X)
    end)
    UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            if bar:IsDescendantOf(gui) then setFromX(mouse.X) end
        end
    end)
end

